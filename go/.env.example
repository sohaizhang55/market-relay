# Go 分发机配置模板。复制为 go/.env 再按机器修改（.env 不进 git）。
# 与 market-relay 的 root/.env 无关；只有 REDIS_* 要和 market-relay 指向同一个 Redis。

# ── Redis ──────────────────────────────────────────────────────────
# 必须和 market-relay 采集器写入的是同一个库
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 对应 market-relay root/.env 的 CACHE_REDIS_SELECT
REDIS_DB=2
# 必填。对应 market-relay root/.env 的 CACHE_PREFIX（没配时 PHP 默认 market_relay_）
# PHP 会给每个键自动加这个前缀，写错了 Go 会读到别的键，而且不报错
REDIS_PREFIX=market_relay_

# ── 分发 ───────────────────────────────────────────────────────────
# 监听地址。本机试跑用 127.0.0.1（避免 Windows 防火墙弹窗）；服务器上对外提供用 0.0.0.0
DISPATCH_HOST=127.0.0.1
# 端口。并行试跑用旁路端口，不和 PHP 的 8594 / 8595 冲突
DISPATCH_SPOT_PORT=18594
DISPATCH_SWAP_PORT=18595
# 取数节拍（毫秒），最小 10
DISPATCH_TICK_MS=100
# 单次写给订阅方阻塞超过多少秒就断开，最小 1
DISPATCH_LAG_CLOSE_SEC=5
# 来源 IP 白名单，逗号分隔；留空 = 不限制
DISPATCH_ALLOW_IPS=
# 读哪个脏集合：
#   shadow  影子脏集合，与 PHP 分发并行试跑（market-relay 采集侧要打开 market.dispatch.shadow_dirty）
#   main    正式脏集合，PHP 分发必须先停，否则两边互相抢走字段
DISPATCH_DIRTY=shadow


charset utf-8;  

index index.html index.htm index.php default.html default.htm default.php;
root  /home/deploy/market-relay/root/public;

error_log  /home/deploy/market-relay/logs/nginx_error.log;
access_log /home/deploy/market-relay/logs/nginx_access.log web_market_relay_log;
 
set $norw 0;
set $isfile 1;

if ( $request_uri ~* ^/adminwss ){
    set $norw 1;
}

if (!-e $request_filename) {
    set $isfile 0;
}  
set $type "$norw$isfile";

if ( $type = "00" ) {
   rewrite  ^(.*)$  /index.php?s=/$1  last;
    break;
}    

location ~* /adminwss
{
    proxy_pass http://127.0.0.1:22365;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header X-Real-IP $remote_addr;
}

location ~* /(public|statics|static|music|upload|css|js|icons)/.*\.(htm|html)(/|$)  {    
    deny all; 
}  

location ~ .*\.(htm|html)$
{
    add_header Cache-Control no-cache;
}

location ~* /(public|statics|static|music|upload)/  { 
    add_header Access-Control-Allow-Origin *;
    add_header Access-Control-Allow-Methods 'GET, POST, OPTIONS';
    add_header Access-Control-Allow-Headers 'UID,TOKEN,DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization,LANG';
    root /home/deploy/market-relay/root/public/;
    
    location ~ .*\.(gif|jpg|jpeg|png|bmp|swf)$
    {
        expires      30d;
    }
    location ~ .*\.(js|css)?$
    {
        expires      12h;
    }
} 

location = /robots.txt {
    allow all;
    log_not_found off;
    access_log off;
}

location ~ \.php$ {
    deny all;
}  
 
location = /index.php 
{	  
    #fastcgi_pass  unix:/tmp/php-cgi7.2.sock; 
    fastcgi_pass  unix:/tmp/php-cgi.sock;
    fastcgi_index index.php; 
    include fastcgi.conf;
    include pathinfo.conf; 

}

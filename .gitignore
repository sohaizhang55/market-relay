# Python 字节码缓存（tools/ 下的导出与校验脚本一跑就生成）
# 绑定解释器版本（cpython-313），换个 Python 就失效，进版本库只制造无意义 diff
__pycache__/
*.pyc

/root/runtime/
/root/safefile
/root/nbproject
!root/composer.json
/root/public/upload
/root/database/sqlite.db

/root/config/app.php
/root/config/database.php
/root/config/log.php
/root/config/key.php
/root/config/admin.php
root/config/market.php

/deploy/nginx/nginx.site
/deploy/nginx/nginx.site.common

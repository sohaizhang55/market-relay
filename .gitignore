/deploy/config.env
# SSL：域名管理页面申请证书时在 ssl/ 下生成私钥与证书，绝不能进仓库；只保留 *.sample 模板
/ssl/*
!/ssl/*.sample

# 数据库备份产物与异地备份密码（deploy/backup/mysql.sh 生成 / 服务器上手工放置）
/deploy/backup/*.sql
/deploy/backup/*.part
/deploy/backup/key*.php
/deploy/backup/backup.pas

# ThinkAdmin 安装插件按本机自动生成（含 CPU / MAC / 本机路径），不能进仓库
/root/vendor/binarys.php

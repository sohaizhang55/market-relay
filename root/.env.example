# 数据配置
DB_TYPE=mysql
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USERNAME=dbuser
DB_MYSQL_DATABASE=dbname
DB_MYSQL_PASSWORD=dbpassword
DB_MYSQL_PREFIX=
DB_MYSQL_CHARSET=utf8mb4

# 缓存配置
CACHE_TYPE=file
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_SELECT=0
CACHE_REDIS_PASSWORD=
# Redis key 前缀（门面与原生调用都生效）。多套部署共用一个 Redis 时必须各配不同值，改值需停全部进程后切换
CACHE_PREFIX=market_relay_

# 会话配置
SESSION_NAME=ssid
SESSION_TYPE=file
SESSION_STORE=
SESSION_EXPIRE=7200
SESSION_PREFIX=

# ─────────────────────────────────────────────────────────────────────────────
# 行情链路 (MARKET_*)：全部有默认值，不写也能跑。
# 取值细节见 config/market.sample.php；本机生效值用 php think market:config_check 看。
# ─────────────────────────────────────────────────────────────────────────────

# ── 内部接口鉴权（唯一安全项，部署必设；install.sh 全新安装时自动生成） ──
# 与订阅方必须同一个值；不配则 /inner_api/* 一律 403。生成：openssl rand -hex 16
# MARKET_INNER_API_TOKEN=
# 允许来源 IP，逗号分隔；留空不限制
# MARKET_INNER_API_ALLOW_IPS=

# ── 分发 ──
# MARKET_DISPATCH_HOST=0.0.0.0
# 现货 / 合约各一个分发进程、各一个端口。必填，没有默认值：留空 market:dispatch 拒绝启动。
# 值见 deploy/ports.env 的 DISPATCH_SPOT_PORT / DISPATCH_CONTRACT_PORT，装机时 deploy/install.sh 第 13 段会写入
MARKET_DISPATCH_SPOT_PORT=
MARKET_DISPATCH_CONTRACT_PORT=
# 分发周期(ms)，也是 depth 最快档(100ms)能兑现的前提。只有 1 Mbps 出口时调到 500
# MARKET_DISPATCH_TICK_MS=100
# 每个订阅方的发送缓冲上限(字节)，不要调大
# MARKET_DISPATCH_MAX_SEND_BUFFER=4194304
# 订阅方持续积压多少秒就断开，重连由快照重放补全量
# MARKET_DISPATCH_LAG_CLOSE_SEC=5
# 成交滚动窗口保留笔数
# MARKET_DISPATCH_TRADE_WINDOW=30

# ── 交易所端点。默认国际版，别改 .us：币种是子集 ──
# MARKET_BINANCE_WS_SPOT=ws://stream.binance.com:9443/stream
# MARKET_BINANCE_REST_SPOT=https://api.binance.com
# MARKET_BINANCE_WS_SWAP_PUBLIC=
# MARKET_BINANCE_WS_SWAP_MARKET=
# MARKET_BINANCE_REST_SWAP=
# MARKET_HUOBI_WS_SPOT=
# MARKET_HUOBI_WS_SWAP=
# MARKET_HUOBI_WS_MARK_PRICE=
# MARKET_HUOBI_REST_SPOT=
# MARKET_HUOBI_REST_SWAP=
# MARKET_BINGX_WS=ws://open-api-swap.bingx.com:443/swap-market
# MARKET_BINGX_REST=https://open-api.bingx.com

# ── 陈旧判定与 REST 兜底 ──
# 价格多少秒没更新算陈旧：撮合 / 强平 / 做市 / 监控 / 告警 / 兜底共用这一个数
# MARKET_STALE_SECONDS=300
# 兜底提前量。触发阈值 = STALE_SECONDS − 本项，默认 0 即与告警同一阈值(300s)、同一时刻动手。
# 调成非 0 会让兜底抢跑（285 就是静默 15 秒即打 REST），代价是更频繁地消耗交易所限流配额
# MARKET_REST_FALLBACK_LEAD_SECONDS=0
# MARKET_REST_FALLBACK_ENABLE=1
# REST 失败后对该 host 的冷却秒数，默认 60
# MARKET_REST_FAIL_COOLDOWN=
# market:price_fallback 每轮最多补几个过期价格，每个交易所进程各算，默认 4。按交易所单独调见 market.php 的 rest_fallback.exchanges
# MARKET_REST_FALLBACK_MAX_FIXES_PER_TICK=4

# ── 主备切换（market:source_select） ──
# 是否启用自动切换，默认 0（不启动选源进程）。先在后台「原始行情」页调好各源断流秒数再设为 1
# MARKET_SOURCE_SELECT_ENABLE=0
# 优先级更高的源恢复后连续健康多少秒才切回
# MARKET_SOURCE_SELECT_RECOVER_SEC=300
# 窗口内切走达到次数就锁定，等人工解锁
# MARKET_SOURCE_SELECT_FLAP_WINDOW_SEC=3600
# MARKET_SOURCE_SELECT_FLAP_MAX=3
# 是否发站内通知与 Telegram（0 = 只写日志）
# MARKET_SOURCE_SELECT_NOTIFY=1

# ── K 线补数（market:kline_backfill；补多少根看 config/market.php 的 kline_retention，默认 2000） ──
# MARKET_KLINE_BACKFILL_ENABLE=1
# 扫描周期(秒) / 单轮时间预算(秒，默认 3)
# MARKET_KLINE_BACKFILL_SCAN_INTERVAL=30
# MARKET_KLINE_BACKFILL_TICK_BUDGET_SEC=
# 落后几个周期算缺口(默认 2) / 每轮最多修几个缺口(默认 20)
# 缺口配额要跟着源数走：轮完一圈 = source_key 数(现网 151) x 6 个周期 ÷ 本值 x scan_interval。
# config/market.php 只在装机时从 sample 复制一次，存量机器改默认值不生效，要在这里显式给。
# 注意配额与 TICK_BUDGET_SEC 取小者生效。撞预算时 market_kline_backfill 会记 warning 并给出
# 本轮实际修了几个，按那个数调 TICK_BUDGET_SEC（K 线补数是独立进程，调大不会推后价格兜底）
# MARKET_KLINE_BACKFILL_GAP_PERIODS=
# MARKET_KLINE_BACKFILL_MAX_FIXES_PER_TICK=20

# ── 数据保留 ──
# K 线保留量按周期直接写在 config/market.php 的 kline_retention 里，没有对应的环境变量

# ── 本地调试 ──
# 只处理这些 source_key（采集、回补、心跳判活一起收窄），生产不要设
# MARKET_DEBUG_SOURCE_KEYS=HUOBI_btcusdt_1,HUOBI_btcusdt_2,BINANCE_btcusdt_1,BINANCE_btcusdt_2

# ── 每日已实现盈亏 ──
# 明细保留天数，0 = 不清理；每月 1 号那行永久保留
# PNL_DAILY_RETENTION_DAYS=400
# 每轮滚动重算今日，后台当天可见（延迟 = 轮询间隔 300s）。全量扫用户，量大就设 false；App 端不受影响
# PNL_COLLECT_TODAY=true
